[Unit]
Description=Service Hub - 我的服务台
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/service-hub
# install.sh 会自动把下一行替换成 `which node` 的真实路径
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=PORT=7788
# 搭配 nginx 反代时（推荐）：取消注释，只监听本机，7788 不直接暴露公网
#Environment=HOST=127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=10

# 新建文件默认仅属主可读写（数据里含账号密码）
UMask=0077

# 低权限用户运行（install.sh 会自动创建）
User=servicehub
Group=servicehub

# —— 沙箱加固 ——
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/service-hub

# 资源限额
LimitNOFILE=4096
MemoryMax=256M

[Install]
WantedBy=multi-user.target
